# ---------------------------------------------------------------- core
# Local development: a file-backed SQLite database, created by `npm run db:reset`.
# Production: point this at Turso/libSQL (libsql://…) and set DATABASE_AUTH_TOKEN.
# The app REFUSES TO START in production if this is still a file: URL — on a
# serverless host that writes to a container that is thrown away.
DATABASE_URL="libsql://personalise-chetucity1.aws-eu-west-1.turso.io"
DATABASE_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODcxNDI5MDIsImlkIjoiMDFhMDFhMDMtZTQwMS03ODNjLTliNzctMmUxMjE0OWJlNDViIiwia2lkIjoicVJSTW5rTlRUR05ONWVRbWVObHpZc0VuOGp2UWlHQnRoVEkxeDEwMks2cyIsInJpZCI6IjRkOGNjOGVlLTAxODItNDg5MC04MTk3LWQwMTc5ZDUyZGNhMSJ9.2W4dcoscG37mFWvVy_6fenifBbk6-71Ii0FUe8468jZKyq_fpq1MV8LzTljCENCod0ryEr5Vu08CJ-tYe-f4Ag"

# Signs the session cookie. Generate one with: openssl rand -base64 32
# Sessions are JWTs signed with this, so anyone who knows it can mint an admin
# login. The app refuses to start in production if it's unset, shorter than 32
# characters, or still the development default.
AUTH_SECRET="change-me"

APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Personalise"

# ------------------------------------------------------------- payments
# on  — students pay by UPI/card inside the app (needs PAYMENT_PROVIDER=razorpay)
# off — students pay their instructor directly (cash, UPI, bank transfer) and the
#       instructor activates the pass from Studio → Fees → Record a payment.
#
# Defaults to OFF, deliberately. The mock payment provider signs its own
# confirmations, so turning payments on without a real gateway configured would
# hand out genuine free passes. The app refuses to start if ONLINE_PAYMENTS=on
# while PAYMENT_PROVIDER=mock in production.
ONLINE_PAYMENTS="off"

# mock      — simulated UPI checkout, no money moves (default)
# razorpay  — live UPI / cards / netbanking
PAYMENT_PROVIDER="mock"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# Set this in the Razorpay dashboard under Settings → Webhooks, pointing at
# https://your-domain/api/payments/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------- live classes
# mock     — no media server needed, runs entirely locally (default)
# livekit  — real WebRTC rooms via LiveKit Cloud or self-hosted
LIVE_PROVIDER="mock"
# LIVEKIT_URL="wss://your-project.livekit.cloud"
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# ------------------------------------------------------ notifications
# console — log emails to the terminal (default)
# resend  — actually send them
#
# Booking confirmations and class reminders are the product's main promise, so
# a pilot wants this on 'resend' with a verified sending domain. Failures are
# logged rather than silently swallowed — check the runtime logs for [notify].
NOTIFY_PROVIDER="console"
# RESEND_API_KEY=""
FROM_EMAIL="no-reply@personalise.local"

# ---------------------------------------------------------------- cron
# Protects /api/cron/*. REQUIRED in production — without it those endpoints
# are disabled entirely (503) rather than left open to the internet.
# On Vercel, setting this env var makes Vercel Cron send it automatically.
# Generate one with: openssl rand -base64 32
# CRON_SECRET=""

# ---------------------------------------------------------------- payouts
# The platform's cut of online payments, as a percentage. Used by the admin
# payout report to work out what each instructor is owed. Offline (cash)
# payments are excluded — that money never passed through the platform.
PLATFORM_FEE_PERCENT="10"
